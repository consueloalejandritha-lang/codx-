# Only content-fingerprinted files get permanent browser caching.
/optimized-assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Same-name editable sources, if served directly, must revalidate.
/portfolio-assets/*
  Cache-Control: public, max-age=0, must-revalidate
